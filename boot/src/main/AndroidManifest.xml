<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Explicit user-granted Android background activity permission for
         standalone shared map intents. Never overlays system warnings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="${bridgeLabel}" android:icon="@drawable/ic_drivelab_boot"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Manual, private on-device surface proof only; never a launcher. -->
        <activity android:name=".BridgeVirtualProbeActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <!-- One-shot physically bounded secondary-display Presentation. -->
        <activity android:name=".BridgeClusterSurfaceProbeActivity"
            android:exported="false"
            android:resizeableActivity="false" />
        <activity android:name=".BridgeLayersActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updatefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/bridge_update_files" />
        </provider>
        <!-- Installer completion/pending-owner-consent only, not exported. -->
        <receiver android:name=".BridgeInstallResultReceiver"
            android:exported="false" />
        <activity android:name=".BootActivity" android:exported="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.config"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Boot is opt-in and never declares HOME; the car's T1 Launcher remains untouched. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".BridgeWheelAccessibilityService"
            android:label="DriveLab Bridge · Volante para mapas"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/bridge_wheel_accessibility" />
        </service>
        <service android:name=".BootLinkService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service android:name=".BootAutoService" android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>

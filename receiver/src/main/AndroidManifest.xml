<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only user-triggered, verified signed updates; system confirmation required. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Standard Automotive MIRROR_FOLD requires OEM-granted signature privilege. -->
    <uses-permission android:name="android.car.permission.CONTROL_CAR_MIRRORS" />
    <queries>
        <package android:name="com.autolink.app.vehicleservice" />
        <package android:name="com.autolink.carservice" />
        <package android:name="com.autolink.clusterinteraction" />
        <package android:name="com.waze" />
        <intent><action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <application android:label="DriveLab Auto Receiver" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider
            android:name="ar.com.rango5gps.drivelabauto.common.UpdateApkProvider"
            android:authorities="${applicationId}.updatefiles"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver android:name=".ReceiverInstallResultReceiver"
            android:exported="false" />
        <service android:name=".ReceiverService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- User-selected Share target inside Jetour T1: maps place -> Waze navigation. -->
        <activity android:name=".ShareToClusterActivity"
            android:exported="true" android:launchMode="singleTop"
            android:label="DriveLab · Navegar en clúster">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="google.com" android:pathPrefix="/maps" />
            </intent-filter>
        </activity>
        <activity android:name=".ReceiverVehicleActivity" android:exported="false" />
        <activity android:name=".ReceiverActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground, one-shot speech only after user enters voice screen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only user-triggered, verified signed updates; system confirmation required. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- GPS is optional: TRIP falls back to flagged OEM-speed distance. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Standard Automotive MIRROR_FOLD requires OEM-granted signature privilege. -->
    <uses-permission android:name="android.car.permission.CONTROL_CAR_MIRRORS" />
    <queries>
        <package android:name="com.autolink.app.vehicleservice" />
        <package android:name="com.autolink.carservice" />
        <package android:name="com.autolink.clusterinteraction" />
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.openai.chatgpt" />
        <!-- Android 11 app-visibility for platform speech recognition. -->
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.ASSIST" /></intent>
        <intent><action android:name="android.intent.action.VOICE_COMMAND" /></intent>
        <intent><action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" /></intent>
        <intent><action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <application android:label="DriveLab Auto Receiver" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider
            android:name="ar.com.rango5gps.drivelabauto.common.UpdateApkProvider"
            android:authorities="${applicationId}.updatefiles"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver android:name=".ReceiverInstallResultReceiver"
            android:exported="false" />
        <service android:name=".ReceiverService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- User-triggered, 35-second OEM 1033 read-only sampler; independent of navigation. -->
        <service android:name=".GearCaptureService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service android:name=".MirrorAutomationService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service android:name=".RecirculationGuardService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Only after user explicitly selects MODO OPTIMIZADO ON.
             GPS foreground service continues when Maps becomes visible;
             never launches on boot without an explicit running service. -->
        <service android:name=".T1OptimizedAutoService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <service android:name=".T1TripRecorderService" android:exported="false"
            android:foregroundServiceType="location|dataSync" />
        <!-- User-started only; bounded PHEV/SOC/wiper/radar and 500m callback probe.
             Foreground service survives navigating to stock T1 screen or Maps. -->
        <service android:name=".T1PhevModeCaptureService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- User-selected Share target inside Jetour T1: maps place -> Waze navigation. -->
        <activity android:name=".ShareToClusterActivity"
            android:exported="true" android:launchMode="singleTop"
            android:label="DriveLab · Navegar en clúster">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="google.com" android:pathPrefix="/maps" />
            </intent-filter>
        </activity>
        <activity android:name=".ReceiverVehicleActivity" android:exported="false" />
        <activity android:name=".T1SteeringKeysActivity" android:exported="false" />
        <activity android:name=".T1ValidationWizardActivity" android:exported="false" />
        <!-- Optional premium cockpit, never a default HOME nor OEM control surface. -->
        <activity android:name=".T1PremiumCockpitActivity" android:exported="false" />
        <activity android:name=".T1OptimizedModeActivity" android:exported="false" />
        <activity android:name=".T1VoiceRouteActivity" android:exported="false" />
        <activity android:name=".T1WhatIfActivity" android:exported="false" />
        <!-- Isolated historical/read-only T1 fuel dashboard; no OEM writes. -->
        <activity android:name=".T1TankDashboardActivity" android:exported="false" />
        <activity android:name=".ReceiverActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
